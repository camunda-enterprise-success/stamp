{
  "schemaId": "builtin:anomaly-detection.metric-events",
  "schemaVersion": "1.0.15",
  "scope": "environment",
  "value": {
    "enabled": true,
    "summary": "[Camunda Infrastructure] ZeebePodCrashLoopingFor20Minutes",
    "queryDefinition": {
      "type": "METRIC_SELECTOR",
      "metricSelector": "dt.kubernetes.container.restarts:filter(contains(\"k8s.pod.name\",\"zeebe\")):splitBy(\"k8s.namespace.name\",\"k8s.pod.name\"):rate(5m)",
      "managementZone": null,
      "queryOffset": null
    },
    "modelProperties": {
      "type": "STATIC_THRESHOLD",
      "threshold": 0,
      "alertOnNoData": false,
      "alertCondition": "ABOVE",
      "violatingSamples": 20,
      "samples": 20,
      "dealertingSamples": 5
    },
    "eventTemplate": {
      "title": "[Camunda Infrastructure] ZeebePodCrashLoopingFor20Minutes",
      "description": "A Zeebe pod ({dims}) has been restarting for more than 20 minutes.\n\nUses the dt.kubernetes.container.restarts built-in (per dynatrace/metric-mapping-8.7.md's Pod Restarts tile), not cAdvisor/kube-state-metrics — requires Dynatrace Kubernetes monitoring.\n\nRunbook: https://github.com/camunda/runbook/blob/main/zeebe/troubleshooting-guide.md#broker-crashes-during-startup",
      "eventType": "AVAILABILITY",
      "davisMerge": true,
      "metadata": [
        { "metadataKey": "team", "metadataValue": "zeebe" },
        { "metadataKey": "source_rule", "metadataValue": "prometheus-grafana/prometheus-alerts/zeebe-resources.yaml#ZeebePodCrashLoopingFor20Minutes" }
      ]
    },
    "eventEntityDimensionKey": null,
    "legacyId": null
  }
}
