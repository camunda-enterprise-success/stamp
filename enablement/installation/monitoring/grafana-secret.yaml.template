# Template for the `grafana-secret` Secret that prometheus-operator-values.yaml reads Grafana's
# admin credentials (and SMTP credentials for alert email) from.
#
# Copy to grafana-secret.yaml.secret, fill in the placeholders, and apply into `default` before
# installing the monitoring stack - step 1 of either guide. The `.secret` suffix keeps the filled-in
# copy out of git; only this template is tracked. Gmail values are only needed for alert emails.
#
#   cp monitoring/grafana-secret.yaml.template monitoring/grafana-secret.yaml.secret
#   kubectl apply -f ./monitoring/grafana-secret.yaml.secret -n default

apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
type: Opaque
stringData:
  admin-user: "<YOUR_ADMIN_USER>"
  admin-password: "<YOUR_ADMIN_PASSWORD>"
  gmail-email: "<YOUR_GMAIL_EMAIL>"
  gmail-password: "<YOUR_GMAIL_APP_PASSWORD>"